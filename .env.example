HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
SESSION_TOKEN=replace-with-a-long-random-local-token
CONTEXT_TTL_MS=300000
INTENT_CONFIDENCE_THRESHOLD=0.8
CONTEXT_MAX_FRAMES=3
CONTEXT_MAX_SECONDS=60
CONTEXT_MAX_IMAGE_BYTES=1200000
CONTEXT_MAX_PAYLOAD_BYTES=4000000
VERTEX_PROJECT_ID=your-gcp-project
VERTEX_REGION=europe-west1
VERTEX_MODEL=gemini-2.5-flash-lite
VERTEX_TIMEOUT_MS=5000
# Uses Google Application Default Credentials; see docs/cloud-setup.md.
